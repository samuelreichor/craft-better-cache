{% import '_includes/forms.twig' as forms %}

<h2>{{ 'Cached Pages'|t('better-cache') }}</h2>

<table class="data fullwidth">
  <thead>
    <tr>
      <th>{{ 'Site'|t('better-cache') }}</th>
      <th>{{ 'Cached pages'|t('better-cache') }}</th>
      <th>{{ 'Stale pages'|t('better-cache') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for site in sites %}
      <tr>
        <td>{{ site.name }}</td>
        <td>{{ site.total }}</td>
        <td>{{ site.stale }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{% for action, section in {
  invalidate: {
    heading: 'Invalidate'|t('better-cache'),
    instructions: 'Applies the refresh strategy to every cached page, like after a deploy.'|t('better-cache'),
    button: 'Invalidate all pages'|t('better-cache'),
  },
  warm: {
    heading: 'Warm'|t('better-cache'),
    instructions: 'Queues a render of all live pages and every known page variant.'|t('better-cache'),
    button: 'Warm the cache'|t('better-cache'),
  },
  clear: {
    heading: 'Clear'|t('better-cache'),
    instructions: 'Deletes all cached pages right away. Visitors render them again.'|t('better-cache'),
    button: 'Clear the cache'|t('better-cache'),
  },
} %}
  <hr>

  <h2>{{ section.heading }}</h2>
  <p>{{ section.instructions }}</p>

  <form method="post" accept-charset="UTF-8">
    {{ actionInput(actions[action]) }}
    {{ csrfInput() }}
    <div class="buttons">
      <button type="submit" class="btn submit secondary">{{ section.button }}</button>
    </div>
  </form>
{% endfor %}

<hr>

<h2>{{ 'Clear a Single URL'|t('better-cache') }}</h2>

<form method="post" accept-charset="UTF-8">
  {{ actionInput(actions.clearUrl) }}
  {{ csrfInput() }}

  {{ forms.textField({
    label: 'URL'|t('better-cache'),
    name: 'url',
    type: 'url',
    placeholder: siteUrl(''),
    required: true,
  }) }}

  <div class="buttons">
    <button type="submit" class="btn submit secondary">{{ 'Clear URL'|t('better-cache') }}</button>
  </div>
</form>
